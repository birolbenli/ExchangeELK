# ================================================================
# Exchange ELK Stack - Environment Configuration
# Sunucu: 32 GB RAM, 8 CPU, 100 GB sistem diski, 2 TB data diski
# 600 mailbox - 90 gün log saklama
# ================================================================

ELASTIC_VERSION=8.11.1

# ---- Elasticsearch ----------------------------------------
# JVM: RAM'in %50'si (max 32 GB kuralı). 32 GB RAM → 16 GB
ES_JAVA_OPTS=-Xms16g -Xmx16g
ELASTICSEARCH_PORT=9200

# ---- Logstash ---------------------------------------------
# 4 worker x 1 GB = 4 GB JVM
LS_JAVA_OPTS=-Xmx4g -Xms4g
LOGSTASH_PORT=5044

# ---- Kibana -----------------------------------------------
KIBANA_PORT=5601

# ---- Disk yolları (tümü 2. disk /data altında) ------------
DATA_ROOT=/data
ELASTICSEARCH_DATA_PATH=/data/elasticsearch/data
ELASTICSEARCH_LOGS_PATH=/data/elasticsearch/logs
ELASTICSEARCH_BACKUP_PATH=/data/elasticsearch/backups
LOGSTASH_DATA_PATH=/data/logstash/data
EXCHANGE_LOGS_PATH=/data/exchange-logs
DOCKER_DATA_ROOT=/data/docker

# ---- ILM - Saklama süreleri (gün) ------------------------
ILM_HOT_DAYS=7
ILM_WARM_DAYS=30
ILM_COLD_DAYS=90
ILM_DELETE_DAYS=90

# ---- Index Ayarları ---------------------------------------
INDEX_SHARDS=3
INDEX_REPLICAS=0
INDEX_REFRESH_INTERVAL=30s

# ---- Güvenlik (production'da true yapın) ------------------
ELASTIC_SECURITY=false

# ---- Log seviyeleri ---------------------------------------
ELASTICSEARCH_LOG_LEVEL=warn
LOGSTASH_LOG_LEVEL=warn
KIBANA_LOG_LEVEL=warn
FILEBEAT_LOG_LEVEL=warning