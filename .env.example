# ================================================================
# Exchange ELK Stack - Environment Configuration TEMPLATE
# Bu dosyayi kopyalayip .env olarak yeniden adlandirin:
#   cp .env.example .env
# Sonra degerlerini doldurun. .env dosyasi git'e gonderilmez.
# ================================================================

ELASTIC_VERSION=9.3.1

# ---- Elasticsearch ----------------------------------------
ES_JAVA_OPTS=-Xms16g -Xmx16g -XX:+UseG1GC -XX:G1HeapRegionSize=32m -XX:MaxGCPauseMillis=200 -XX:+UnlockExperimentalVMOptions -XX:G1NewSizePercent=20 -XX:G1MaxNewSizePercent=40 -XX:InitiatingHeapOccupancyPercent=70 -XX:+ParallelRefProcEnabled -XX:ConcGCThreads=4 -XX:ParallelGCThreads=8
ELASTICSEARCH_PORT=9200

# ---- Logstash ---------------------------------------------
LS_JAVA_OPTS=-Xms2g -Xmx4g -XX:+UseG1GC -XX:G1HeapRegionSize=16m -XX:MaxGCPauseMillis=500 -XX:ConcGCThreads=2 -XX:ParallelGCThreads=4
LOGSTASH_PORT=5044

# ---- Kibana -----------------------------------------------
KIBANA_PORT=5601

# ---- Disk yolları (tümü 2. disk /data altında) ------------
DATA_ROOT=/data
ELASTICSEARCH_DATA_PATH=/data/elasticsearch/data
ELASTICSEARCH_LOGS_PATH=/data/elasticsearch/logs
ELASTICSEARCH_BACKUP_PATH=/data/elasticsearch/backups
LOGSTASH_DATA_PATH=/data/logstash/data
EXCHANGE_LOGS_PATH=/data/exchange-logs
DOCKER_DATA_ROOT=/data/docker

# ---- ILM - Saklama süreleri (gün) ------------------------
ILM_HOT_DAYS=7
ILM_WARM_DAYS=30
ILM_COLD_DAYS=90
ILM_DELETE_DAYS=90

# ---- Index Ayarları ---------------------------------------
INDEX_SHARDS=3
INDEX_REPLICAS=0
INDEX_REFRESH_INTERVAL=30s

# ---- Güvenlik --------------------------------------------------
ELASTIC_SECURITY=true
ELASTIC_PASSWORD=CHANGE_ME_STRONG_PASSWORD
KIBANA_SYSTEM_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---- Log seviyeleri ---------------------------------------
ELASTICSEARCH_LOG_LEVEL=warn
